              "});",
              "pm.test('AT-14: загруженный файл присутствует', () => {",
              "  const list = pm.response.json();",
              "  const mediaId = pm.collectionVariables.get('mediaId');",
              "  if (mediaId) {",
              "    const found = list.some(m => m.id === mediaId);",
              "    pm.expect(found).to.be.true;",
              "  } else {",
              "    pm.expect(list).to.be.an('array');",
              "  }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/images/library"
      }
    },
