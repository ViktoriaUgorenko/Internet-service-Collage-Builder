{
  "info": {
    "name": "Collage Maker API — AT-01..AT-15",
    "description": "Автоматизированное тестирование REST API (Таблица 4.2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",   "value": "https://localhost",  "type": "string" },
    { "key": "token",     "value": "",                   "type": "string" },
    { "key": "projectId", "value": "",                   "type": "string" },
    { "key": "mediaId",   "value": "",                   "type": "string" },
    { "key": "testEmail", "value": "at_test_{{$randomInt}}@example.com", "type": "string" },
    { "key": "testPass",  "value": "Test1234",           "type": "string" }
  ],
  "item": [
    {
      "name": "AT-01 — Активность сервиса и БД",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('AT-01: статус 200', () => pm.response.to.have.status(200));",
              "pm.test('AT-01: поле status = ok', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('ok');",
              "});",
              "pm.test('AT-01: БД подключена', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.db).to.eql('connected');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "AT-02 — Регистрация пользователя",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const ts = Date.now();",
              "pm.collectionVariables.set('testEmail', `at_test_${ts}@example.com`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('AT-02: статус 201 или 200', () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "pm.test('AT-02: есть token', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.token).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('token', body.token);",
              "});",
              "pm.test('AT-02: есть данные пользователя', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.email).to.be.a('string');",
              "  pm.expect(body.id).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPass}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
