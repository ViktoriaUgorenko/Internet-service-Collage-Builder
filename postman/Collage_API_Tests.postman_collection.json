              "  pm.collectionVariables.set('projectId', body.id);",
              "});",
              "pm.test('AT-08: title совпадает', () => {",
              "  pm.expect(pm.response.json().title).to.eql('AT Test Project');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
